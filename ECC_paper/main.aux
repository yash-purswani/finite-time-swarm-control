\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Transient safety and connectivity verification over $t\in [0,2.5]$~s. In both panels, columns show the minimum pairwise separation $d_x(t)$ (left), maximum pairwise distance $\ell _x(t)$ (middle), and geometric margin $s(t)$ versus disagreement tube $\rho _H(t)$ (right). \textbf  {Left:} Star compression ($\kappa =5.0$); top row: Certified Safe ($m=30.0$), bottom row: Unsafe Mid-Transient Collision ($m=0.0$). \textbf  {Right:} Star expansion ($\kappa =8.0$); top row: Certified Safe \& Connected ($m=25.0$), bottom row: Unsafe Transient Disconnection ($m=0.0$). }}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:transient-safety-connectivity}{{2}{6}{Transient safety and connectivity verification over $t\in [0,2.5]$~s. In both panels, columns show the minimum pairwise separation $d_x(t)$ (left), maximum pairwise distance $\ell _x(t)$ (middle), and geometric margin $s(t)$ versus disagreement tube $\rho _H(t)$ (right). \textbf {Left:} Star compression ($\kappa =5.0$); top row: Certified Safe ($m=30.0$), bottom row: Unsafe Mid-Transient Collision ($m=0.0$). \textbf {Right:} Star expansion ($\kappa =8.0$); top row: Certified Safe \& Connected ($m=25.0$), bottom row: Unsafe Transient Disconnection ($m=0.0$)}{figure.caption.4}{}}
\newlabel{fig:transient-safety-connectivity@cref}{{[figure][2][]2}{[1][5][]6}{}{}{}}
