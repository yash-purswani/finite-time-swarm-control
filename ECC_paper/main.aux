\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Arbitrary formation morphing and constrained corridor traversal ($n=10$, $m=10.0$). Snapshots depict: (a) approach and finite-time convergence in ring geometry ($t=1.2$~s), (b) morphing into a slender chevron to navigate the narrow corridor ($t=8.0$~s), and (c) exit and ring recovery ($t=16.2$~s). Target stations $q_i$ (circles), agent positions $x_i$ (colored dots), continuous trajectories, reference centroid $r(t)$ (dashed line), and the 10-cycle backbone $\mathcal  {H}$ (solid blue edges) remain strictly collision-free ($d_{x,\min } \ge 1.32$~m) and connected ($\ell _{x,\max } \le 2.22$~m).}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:reconfiguration}{{3}{7}{Arbitrary formation morphing and constrained corridor traversal ($n=10$, $m=10.0$). Snapshots depict: (a) approach and finite-time convergence in ring geometry ($t=1.2$~s), (b) morphing into a slender chevron to navigate the narrow corridor ($t=8.0$~s), and (c) exit and ring recovery ($t=16.2$~s). Target stations $q_i$ (circles), agent positions $x_i$ (colored dots), continuous trajectories, reference centroid $r(t)$ (dashed line), and the 10-cycle backbone $\mathcal {H}$ (solid blue edges) remain strictly collision-free ($d_{x,\min } \ge 1.32$~m) and connected ($\ell _{x,\max } \le 2.22$~m)}{figure.caption.6}{}}
\newlabel{fig:reconfiguration@cref}{{[figure][3][]3}{[1][5][]7}{}{}{}}
