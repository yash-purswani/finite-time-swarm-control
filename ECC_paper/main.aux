\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Transient safety and connectivity verification across aggressive compression and expansion maneuvers ($\kappa =12.0$, $t\in [0,2.5]$~s). In both panels, columns show the minimum pairwise separation $d_x(t)$ (left), maximum pairwise distance $\ell _x(t)$ (middle), and geometric margin $s(t)$ versus disagreement tube $\rho _H(t)$ (right). \textbf  {Left:} Star compression ($a_0 = 1.70 \to a_\infty = 0.72$); safe case ($m=60.0$, certified collision-free), unsafe case ($m=1.0$, collision breach observed). \textbf  {Right:} Star expansion ($a_0 = 1.70 \to a_\infty = 3.02$); safe case ($m=60.0$, certified connected), unsafe case ($m=1.0$, transient connectivity violation observed). }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:transient-safety-connectivity}{{2}{7}{Transient safety and connectivity verification across aggressive compression and expansion maneuvers ($\kappa =12.0$, $t\in [0,2.5]$~s). In both panels, columns show the minimum pairwise separation $d_x(t)$ (left), maximum pairwise distance $\ell _x(t)$ (middle), and geometric margin $s(t)$ versus disagreement tube $\rho _H(t)$ (right). \textbf {Left:} Star compression ($a_0 = 1.70 \to a_\infty = 0.72$); safe case ($m=60.0$, certified collision-free), unsafe case ($m=1.0$, collision breach observed). \textbf {Right:} Star expansion ($a_0 = 1.70 \to a_\infty = 3.02$); safe case ($m=60.0$, certified connected), unsafe case ($m=1.0$, transient connectivity violation observed)}{figure.caption.4}{}}
\newlabel{fig:transient-safety-connectivity@cref}{{[figure][2][]2}{[1][5][]7}{}{}{}}
