\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Transient safety and connectivity verification over $t\in [0,2.5]$~s. In both subfigures, columns compare the certified safe design ($m=30.0$, left) against the uncoupled baseline ($m=0.0$, right). Rows display: minimum pairwise separation $d_x(t)$ (top), maximum pairwise distance $\ell _x(t)$ (middle), and geometric margin $s(t)$ versus disagreement tube $\rho _{\mathcal  {H}}(t)$ (bottom). \textbf  {(a) Left:} Star compression ($\kappa =5.0$), where uncoupled tracking exhibits a physical collision breach ($d_x < d_{\mathrm  {safe}}$). \textbf  {(b) Right:} Star expansion ($\kappa =8.0$), where uncoupled tracking exhibits a transient communication-range violation ($\ell _x > R_c$). A failed certificate alone is inconclusive and does not imply a violation. }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:transient-safety-connectivity}{{2}{7}{Transient safety and connectivity verification over $t\in [0,2.5]$~s. In both subfigures, columns compare the certified safe design ($m=30.0$, left) against the uncoupled baseline ($m=0.0$, right). Rows display: minimum pairwise separation $d_x(t)$ (top), maximum pairwise distance $\ell _x(t)$ (middle), and geometric margin $s(t)$ versus disagreement tube $\rho _{\mathcal {H}}(t)$ (bottom). \textbf {(a) Left:} Star compression ($\kappa =5.0$), where uncoupled tracking exhibits a physical collision breach ($d_x < \dsafe $). \textbf {(b) Right:} Star expansion ($\kappa =8.0$), where uncoupled tracking exhibits a transient communication-range violation ($\ell _x > \Rc $). A failed certificate alone is inconclusive and does not imply a violation}{figure.caption.4}{}}
\newlabel{fig:transient-safety-connectivity@cref}{{[figure][2][]2}{[1][6][]7}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Certificate and observed transient-geometry outcomes for aggressive star maneuvers ($t\in [0,2.5]$~s). A failed certificate is inconclusive rather than a prediction of failure.}}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:safety-comparison}{{III}{7}{Certificate and observed transient-geometry outcomes for aggressive star maneuvers ($t\in [0,2.5]$~s). A failed certificate is inconclusive rather than a prediction of failure}{table.caption.5}{}}
\newlabel{tab:safety-comparison@cref}{{[table][3][]III}{[1][6][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Arbitrary formation morphing and constrained corridor traversal ($n=10$, $m=10.0$). Snapshots depict: (a) approach and finite-time convergence in ring geometry ($t=1.2$~s), (b) morphing into a slender chevron to navigate the narrow corridor ($t=8.0$~s), and (c) exit and ring recovery ($t=16.2$~s). Target stations $q_i$ (circles), agent positions $x_i$ (colored dots), continuous trajectories, reference centroid $r(t)$ (dashed line), and the 10-cycle backbone $\mathcal  {H}$ (solid blue edges) remain strictly collision-free ($d_{x,\min } \ge 1.32$~m) and connected ($\ell _{x,\max } \le 2.22$~m).}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:reconfiguration}{{3}{8}{Arbitrary formation morphing and constrained corridor traversal ($n=10$, $m=10.0$). Snapshots depict: (a) approach and finite-time convergence in ring geometry ($t=1.2$~s), (b) morphing into a slender chevron to navigate the narrow corridor ($t=8.0$~s), and (c) exit and ring recovery ($t=16.2$~s). Target stations $q_i$ (circles), agent positions $x_i$ (colored dots), continuous trajectories, reference centroid $r(t)$ (dashed line), and the 10-cycle backbone $\mathcal {H}$ (solid blue edges) remain strictly collision-free ($d_{x,\min } \ge 1.32$~m) and connected ($\ell _{x,\max } \le 2.22$~m)}{figure.caption.6}{}}
\newlabel{fig:reconfiguration@cref}{{[figure][3][]3}{[1][6][]8}{}{}{}}
