% IEEEtran.bst controls (activated by \bstctlcite in main.tex): write
% repeated author lists in full instead of a dash, and use "et al." after the
% first author when there are more than six authors (IEEE Reference Guide).
@IEEEtranBSTCTL{IEEEexample:BSTcontrol,
  CTLdash_repeated_names   = "no",
  CTLuse_forced_etal       = "yes",
  CTLmax_names_forced_etal = "6",
  CTLnames_show_etal       = "1"
}

% DOIs are printed through note (IEEEtran.bst ignores the doi field), as in
% the L-CSS template: "..., Mon. year, doi: 10.xxxx/yyyy." \nolinkurl lets a
% long DOI break across lines in the narrow column.
@preamble{"\providecommand{\bibdoi}[1]{doi: \href{https://doi.org/#1}{\nolinkurl{#1}}}"}

